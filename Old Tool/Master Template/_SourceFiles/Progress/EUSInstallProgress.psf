  <Code><![CDATA[param (
	[string]$Commandline
)

$formEUSInstallProgress_Load = {
	
	#TODO: Initialize Form Controls here
	#region Set DPI Awareness
	$null = Add-Type -TypeDefinition @"
	using System;
	using System.Runtime.InteropServices;
	namespace SAPIEN
	{
		public static class DPIAware
		{
			public enum PROCESS_DPI_AWARENESS
			{
				PROCESS_DPI_UNAWARE = 0,
				PROCESS_SYSTEM_DPI_AWARE = 1,
				PROCESS_PER_MONITOR_DPI_AWARE = 2
			}
	
			[DllImport("SHCore.dll", SetLastError = true)]
			public static extern int SetProcessDpiAwareness(PROCESS_DPI_AWARENESS awareness);
		}
	}
"@
	
	#Call before displaying a GUI
	[SAPIEN.DPIAware]::SetProcessDpiAwareness('PROCESS_SYSTEM_DPI_AWARE')
	#endregion
	
	$formEUSInstallProgress.AutoScaleMode = 'DPI'
	$formEUSInstallProgress.AutoScale = $true
	
	
	$Size = [System.Windows.Forms.SystemInformation]::PrimaryMonitorSize
	$xResolution = $Size.Width
	$yResolution = $Size.Height
	$xLocation = $xResolution - 20 - ($formEUSInstallProgress.Width)
	$yLocation = 55
	$xLocation = $xResolution - 20 - ($formEUSInstallProgress.Width) #20 pixels from right end of screen
	#$yLocation = $yResolution - 55 - ($formProgress.Height) #55 pixels from the botton end of the screen
	$yLocation = 55
	
	$formEUSInstallProgress.StartPosition = 'Manual'
	$formEUSInstallProgress.Location = New-Object System.Drawing.Point($xLocation, $yLocation)
	
	$Script:formProgressVertical = 1
	$script:goalHeightProgress = $labelTip.Location.Y + $labelTip.Height + 2
	$formEUSInstallProgress.Height = $formProgressVertical
	
	if ($Commandline.ToLower().Contains("/reboot"))
	{
		$script:labelChangeArray = "We are updating your device and will be done shortly.", "Please close all applications in preparation for a restart. We'll let you know when.", "Please be patient as we finalize the settings."
	}
	Else
	{
		$script:labelChangeArray = "We are updating your device and will be done shortly.", "Please don't launch the applications you closed. We'll let you know when.", "Please be patient as we finalize the settings."
	}
	$script:labelChangeIndex = 0
	
	$timerProgress.Enabled = $true
	$timerProgress.Interval = 5000 # internval is in milliseconds, so 7000 means a 7 seconds. 
	$timerProgress.Start()
	$timerProgress.add_Tick($timerProgress_Tick)
	
	# Code below is to spawn the dialog where it doesnt just pop-up, it has a slow drop down effect. 
	# The '$timerFormSpawnProgress_Tick' is a ticker to spawn the dialog to its max height of 115.
	$timerFormSpawnProgress.Enabled = $true
	$timerFormSpawnProgress.Interval = 5
	$timerFormSpawnProgress.Start()
	$timerFormSpawnProgress.add_Tick($timerFormSpawnProgress_Tick)
	#$timerFormSpawnProgress.Stop()
	
	

}

$timerFormSpawnProgress_Tick = {
	
	If ($script:formProgressVertical -lt $goalHeightProgress)
	{
		$script:formProgressVertical = $script:formProgressVertical + 5
		$formEUSInstallProgress.Height = $script:formProgressVertical
		$formEUSInstallProgress.Refresh()
	}
	Else
	{
		#Write-FRBLog -Message "Progress form spawn completed." -Path $PKGR_LogPath -NoConsoleOut -Level Info
		$formEUSInstallProgress.Refresh()
		$timerFormSpawnProgress.Stop()
		#$formProgress.Close()
	}
}


$timerProgress_Tick = {
	
	$labelProgress.Text = $script:labelChangeArray[$script:labelChangeIndex]
	$script:labelChangeIndex++
	
	If ($script:labelChangeIndex -ge $labelChangeArray.Length)
	{
		$script:labelChangeIndex = 0
	}
	
}

$buttonMinimize_Click={
	#TODO: Place custom script here
	$formEUSInstallProgress.WindowState = 'Minimized'
}


$formEUSInstallProgress_FormClosing = [System.Windows.Forms.FormClosingEventHandler]{
	#Event Argument: $_ = [System.Windows.Forms.FormClosingEventArgs]
	#TODO: Place custom script here
	#Write-FRBLog -Message "Progress form is closing." -Path $PKGR_LogPath -NoConsoleOut -Level Info
	$formProgress.Visible = $false
}

$labelXML_Click={
	#TODO: Place custom script here
	
}
]]></Code>
