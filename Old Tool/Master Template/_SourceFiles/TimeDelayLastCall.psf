  <Code><![CDATA[

$formFinalMinsDropDown_Load={
	#TODO: Initialize Form Controls here
	$formFinalMinsDropDown.AutoScaleMode = 'DPI'
	$formFinalMinsDropDown.AutoSize = $false
	$finalminutes = 10
	$yloc = $parentFormLocY + $goalHeight - 2
	#$yloc = $parentFormLocY + $parentFormHeight - $parentFormHeightCollapse -2
	$xloc = $parentFormLocX + ($parentFormWidth - $formFinalMinsDropDown.Width)
	$formFinalMinsDropDown.Location = New-Object System.Drawing.Point($xloc, $yloc)
	$buttonOption1.Text = "Final $finalminutes Minutes"
	$script:EndTimeDropFinal = (Get-Date).AddSeconds(10) # this 'Minutes' is the number of minutes the dialog will stay up. 
	$timerDropDownFinal.Enabled = $true
	$timerDropDownFinal.Interval = 1000 # internval is in milliseconds, so 1000 means a second. 
	$timerDropDownFinal.Start()
	$timerDropDownFinal.add_Tick($timerDropDownFinal_Tick)
}


$buttonOption1_Click={
	#TODO: Place custom script here
	$script:timeSelected = $finalminutes
	$formFinalMinsDropDown.Close()
}


$buttonCloseOptions_Click={
	#TODO: Place custom script here
	$script:FinalMinsCancelSelected = $true
	$formFinalMinsDropDown.Close()
}

$timerDropDownFinal_Tick={
	#TODO: Place custom script here
	$spanDropFinal = $script:EndTimeDropFinal - (Get-Date)
	#$buttonOption3.Text = $spanDropFinal
	if ($spanDropFinal.totalseconds -le 0)
	{
		$script:FinalMinsCancelSelected = $true
		$timerDropDownFinal.Stop()
		$formFinalMinsDropDown.Close()
	}
}
]]></Code>
