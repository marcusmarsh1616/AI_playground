"""
GitLab Master Template Download via Playwright + Okta
Based on ServiceNow Playwright pattern
"""

from typing import Optional
from playwright.sync_api import sync_playwright, Browser, BrowserContext, Page, TimeoutError as PlaywrightTimeout
from pathlib import Path
from urllib.parse import urlparse, quote
import time
import json
import sys

# Simple logger for standalone testing
class SimpleLogger:
    def info(self, msg):
        timestamp = time.strftime('%Y-%m-%d %H:%M:%S')
        print(f"[{timestamp}] INFO: {msg}")
    
    def warning(self, msg):
        timestamp = time.strftime('%Y-%m-%d %H:%M:%S')
        print(f"[{timestamp}] WARNING: {msg}")
    
    def error(self, msg):
        timestamp = time.strftime('%Y-%m-%d %H:%M:%S')
        print(f"[{timestamp}] ERROR: {msg}", file=sys.stderr)

logger = SimpleLogger()


class GitLabOktaDownloader:
    """
    Downloads Master Template from GitLab using Okta authentication
    """
    
    def __init__(self, 
                 gitlab_url: str,
                 okta_url: str = "https://frbanks.okta.com",
                 download_path: str = "./downloads",
                 session_file: str = "./session_state.json",
                 headless: bool = False):
        """
        Initialize GitLab downloader
        
        Args:
            gitlab_url: Full GitLab project URL
            okta_url: Okta SSO URL
            download_path: Where to save downloaded files
            session_file: Where to save/load browser session
            headless: Run browser in headless mode
        """
        self.gitlab_url = gitlab_url
        self.okta_url = okta_url
        self.download_path = Path(download_path)
        self.session_file = Path(session_file)
        self.headless = headless
        
        self.playwright = None
        self.browser: Optional[Browser] = None
        self.context: Optional[BrowserContext] = None
        self.page: Optional[Page] = None
        
        # Ensure download directory exists
        self.download_path.mkdir(parents=True, exist_ok=True)
    
    def download_template(self, force_new_login: bool = False) -> Optional[str]:
        """
        Download Master Template from GitLab
        
        Args:
            force_new_login: If True, ignore saved session and force new login
            
        Returns:
            Path to downloaded file if successful, None otherwise
        """
        try:
            logger.info("="*80)
            logger.info("GITLAB MASTER TEMPLATE DOWNLOAD - PLAYWRIGHT + OKTA")
            logger.info("="*80)
            
            # Try to restore saved session first
            if not force_new_login and self._try_restore_session():
                logger.info("Using saved session - attempting download...")
                return self._download_archive()
            
            # Perform new login
            logger.info("Starting new Okta authentication...")
            if self._perform_okta_login():
                return self._download_archive()
            else:
                logger.error("Authentication failed")
                return None
                
        except Exception as e:
            logger.error(f"Download failed: {e}")
            return None
        finally:
            self._cleanup_browser()
    
    def _try_restore_session(self) -> bool:
        """
        Try to restore from saved session state
        
        Returns:
            True if session restored and valid, False otherwise
        """
        try:
            if not self.session_file.exists():
                logger.info("No saved session found")
                return False
            
            logger.info("Loading saved session...")
            with open(self.session_file, 'r') as f:
                saved_state = json.load(f)
            
            # Start browser with saved state
            self._start_browser(storage_state=saved_state)
            
            # Navigate to GitLab to test session
            logger.info("Testing saved session on GitLab...")
            self.page.goto(self.gitlab_url, timeout=30000)
            self.page.wait_for_load_state('networkidle', timeout=30000)
            
            current_url = self.page.url
            
            # If redirected to Okta, session expired
            if 'okta.com' in current_url.lower():
                logger.warning("Session expired - redirected to Okta")
                self._cleanup_browser()
                return False
            
            logger.info("Saved session is valid!")
            return True
            
        except Exception as e:
            logger.warning(f"Failed to restore session: {e}")
            self._cleanup_browser()
            return False
    
    def _perform_okta_login(self) -> bool:
        """
        Perform Okta authentication for GitLab access
        
        Returns:
            True if authentication successful, False otherwise
        """
        try:
            logger.info("Starting browser for Okta login...")
            self._start_browser()
            
            # Navigate to GitLab (will redirect to Okta)
            logger.info(f"Navigating to: {self.gitlab_url}")
            self.page.goto(self.gitlab_url)
            
            # Wait for network to settle after redirects
            logger.info("Waiting for authentication redirects...")
            self.page.wait_for_load_state('networkidle', timeout=60000)
            
            logger.info("="*80)
            logger.info("PLEASE COMPLETE OKTA AUTHENTICATION IN THE BROWSER:")
            logger.info("="*80)
            logger.info("  1. Enter your Okta username/password (if prompted)")
            logger.info("  2. Approve Push notification on your phone")
            logger.info("  3. Complete any additional MFA steps")
            logger.info("")
            logger.info("Waiting for GitLab page (up to 5 minutes)...")
            logger.info("="*80)
            
            # Wait for GitLab page to load (title check)
            try:
                self.page.wait_for_function(
                    """() => {
                        const pageTitle = document.title;
                        const pageUrl = window.location.href;
                        return (pageTitle.includes('GitLab') || 
                                pageUrl.includes('gitlab')) &&
                               !pageUrl.includes('okta.com');
                    }""",
                    timeout=300000  # 5 minutes
                )
                
                logger.info("="*80)
                logger.info("GITLAB PAGE DETECTED!")
                logger.info(f"Page Title: {self.page.title()}")
                logger.info(f"URL: {self.page.url}")
                logger.info("="*80)
                
                # Brief pause to let page stabilize
                time.sleep(2)
                
                # Save session for future use
                self._save_session()
                
                return True
                
            except PlaywrightTimeout:
                logger.error("="*80)
                logger.error("TIMEOUT - Did not reach GitLab page in 5 minutes")
                logger.error(f"Last URL: {self.page.url}")
                logger.error(f"Last Title: {self.page.title()}")
                logger.error("="*80)
                
                # Save screenshot for debugging
                screenshot_path = Path(__file__).parent.parent / 'logs' / 'timeout_screenshot.png'
                screenshot_path.parent.mkdir(parents=True, exist_ok=True)
                self.page.screenshot(path=str(screenshot_path))
                logger.error(f"Screenshot saved: {screenshot_path}")
                
                return False
            
        except Exception as e:
            logger.error(f"Okta login failed: {e}")
            return False
    
    def _download_archive(self) -> Optional[str]:
        """
        Download the repository archive (zip file)
        
        Returns:
            Path to downloaded file if successful, None otherwise
        """
        try:
            logger.info("="*80)
            logger.info("DOWNLOADING REPOSITORY ARCHIVE...")
            logger.info("="*80)
            
            # Parse GitLab URL to construct web UI download URL
            parsed = urlparse(self.gitlab_url)
            base_url = f"{parsed.scheme}://{parsed.netloc}"
            project_path = parsed.path.lstrip('/')
            
            # Extract project name (last part of path)
            project_name = project_path.split('/')[-1]
            
            # Use GitLab web UI download pattern (works with browser session)
            # Pattern: {project_url}/-/archive/{branch}/{project_name}-{branch}.zip?ref_type=heads
            download_url = f"{self.gitlab_url}/-/archive/master/{project_name}-master.zip?ref_type=heads"
            
            logger.info(f"GitLab Project: {project_name}")
            logger.info(f"Web UI Download URL: {download_url}")
            
            # Set up download handler
            download_path = None
            
            with self.page.expect_download(timeout=120000) as download_info:
                logger.info("Navigating to download URL...")
                self.page.goto(download_url)
            
            download = download_info.value
            timestamp = time.strftime('%Y%m%d_%H%M%S')
            download_filename = f"master-template-{timestamp}.zip"
            download_path = self.download_path / download_filename
            
            logger.info(f"Saving file as: {download_filename}")
            download.save_as(str(download_path))
            
            logger.info("="*80)
            logger.info("DOWNLOAD SUCCESSFUL!")
            logger.info(f"File saved: {download_path}")
            logger.info(f"File size: {download_path.stat().st_size:,} bytes")
            logger.info("="*80)
            
            return str(download_path)
            
        except Exception as e:
            logger.error(f"Download failed: {e}")
            return None
    
    def _start_browser(self, storage_state: Optional[dict] = None) -> None:
        """
        Start Playwright browser
        
        Args:
            storage_state: Optional saved storage state to restore
        """
        logger.info("Starting Playwright browser...")
        self.playwright = sync_playwright().start()
        
        # Launch browser
        self.browser = self.playwright.chromium.launch(
            headless=self.headless,
            channel="msedge",  # Use system Edge
            slow_mo=50  # Slow down for debugging
        )
        
        # Create context with or without saved state
        context_options = {}
        if storage_state:
            context_options['storage_state'] = storage_state
        
        # Add download directory to accept downloads
        context_options['accept_downloads'] = True
        
        self.context = self.browser.new_context(**context_options)
        self.page = self.context.new_page()
        
        logger.info(f"Microsoft Edge browser started (headless={self.headless})")
    
    def _save_session(self) -> bool:
        """
        Save current session state to file
        
        Returns:
            True if saved successfully, False otherwise
        """
        try:
            logger.info("Saving session state...")
            storage_state = self.context.storage_state()
            
            with open(self.session_file, 'w') as f:
                json.dump(storage_state, f, indent=2)
            
            logger.info(f"Session saved: {self.session_file}")
            logger.info("Next time this will skip authentication!")
            return True
            
        except Exception as e:
            logger.warning(f"Failed to save session: {e}")
            return False
    
    def _cleanup_browser(self) -> None:
        """Clean up browser resources"""
        try:
            if self.page:
                self.page.close()
                self.page = None
            if self.context:
                self.context.close()
                self.context = None
            if self.browser:
                self.browser.close()
                self.browser = None
            if self.playwright:
                self.playwright.stop()
                self.playwright = None
        except Exception as e:
            logger.warning(f"Error during browser cleanup: {e}")


def main():
    """
    Main entry point for testing
    """
    import argparse
    
    parser = argparse.ArgumentParser(description='Download GitLab Master Template via Okta')
    parser.add_argument('--gitlab-url', required=True, help='GitLab project URL')
    parser.add_argument('--okta-url', default='https://frbanks.okta.com', help='Okta SSO URL')
    parser.add_argument('--download-path', default='./downloads', help='Download directory')
    parser.add_argument('--session-file', default='./session_state.json', help='Session state file')
    parser.add_argument('--headless', action='store_true', help='Run in headless mode')
    parser.add_argument('--force-login', action='store_true', help='Force new login (ignore saved session)')
    parser.add_argument('--auth-only', action='store_true', help='Authenticate only (do not download)')
    
    args = parser.parse_args()
    
    downloader = GitLabOktaDownloader(
        gitlab_url=args.gitlab_url,
        okta_url=args.okta_url,
        download_path=args.download_path,
        session_file=args.session_file,
        headless=args.headless
    )
    
    # Handle auth-only mode (authenticate but do not download)
    if args.auth_only:
        logger.info("="*80)
        logger.info("AUTH-ONLY MODE: Will authenticate and save session only")
        logger.info("="*80)
        
        if downloader._perform_okta_login():
            logger.info("="*80)
            logger.info("AUTHENTICATION SUCCESSFUL!")
            logger.info("Session saved - future runs will skip authentication")
            logger.info("="*80)
            sys.exit(0)
        else:
            logger.error("="*80)
            logger.error("AUTHENTICATION FAILED")
            logger.error("="*80)
            sys.exit(1)
    
    # Normal mode: authenticate and download
    result = downloader.download_template(force_new_login=args.force_login)
    
    if result:
        print(f"\nSUCCESS: Downloaded to {result}")
        sys.exit(0)
    else:
        print("\nFAILED: Could not download template")
        sys.exit(1)


if __name__ == '__main__':
    main()
