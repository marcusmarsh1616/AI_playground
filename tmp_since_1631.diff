+function Write-TestExecutionDiagnostics {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Stage,
+
+        [Parameter(Mandatory = $true)]
+        [hashtable]$Result
+    )
+
+    if (-not $Result) {
+        return
+    }
+
+    $exitCodeLabel = if ($Result.ContainsKey('ExitCode')) { [string]$Result.ExitCode } else { 'N/A' }
+    $processLabel = if ($Result.ContainsKey('ProcessId') -and $Result.ProcessId) { [string]$Result.ProcessId } else { 'N/A' }
+    $commandLine = "{0} {1}" -f $Result.InstallExePath, $Result.Arguments
+    $commandLine = $commandLine.Trim()
+
+    Write-ProcessOutputLine -Message ("{0} execution summary | ProcessId={1} ExitCode={2} Command={3}" -f $Stage, $processLabel, $exitCodeLabel, $commandLine) -Level "INFO"
+
+    if ($Result.ContainsKey('CleanupResults') -and $Result.CleanupResults) {
+        $cleanup = $Result.CleanupResults
+        Write-ProcessOutputLine -Message ("{0} cleanup summary | Attempted={1} Cleaned={2} Failed={3} Preserved={4}" -f $Stage, $cleanup.Attempted, $cleanup.TotalCleaned, $cleanup.TotalFailed, $cleanup.PreservedCount) -Level "INFO"
+    }
+
+    if ($Result.ContainsKey('ReportPath') -and -not [string]::IsNullOrWhiteSpace([string]$Result.ReportPath)) {
+        Write-ProcessOutputLine -Message ("{0} report path: {1}" -f $Stage, $Result.ReportPath) -Level "INFO"
+    }
+
+    if ($Result.ContainsKey('Diagnostics') -and $Result.Diagnostics) {
+        if ($Result.Diagnostics.Files -and $Result.Diagnostics.Files.Count -gt 0) {
+            foreach ($diagFile in @($Result.Diagnostics.Files)) {
+                Write-ProcessOutputLine -Message ("{0} evidence file: {1} (LastWrite={2}, Size={3} bytes)" -f $Stage, $diagFile.Path, $diagFile.LastWriteTime, $diagFile.Size) -Level "INFO"
+            }
+        }
+        else {
+            Write-ProcessOutputLine -Message ("{0} diagnostics: no recent install/uninstall log files detected." -f $Stage) -Level "WARN"
+        }
+
+        if ($Result.Diagnostics.TailLines -and $Result.Diagnostics.TailLines.Count -gt 0) {
+            foreach ($tailLine in @($Result.Diagnostics.TailLines)) {
+                Write-ProcessOutputLine -Message ("{0} log tail: {1}" -f $Stage, $tailLine) -Level "INFO"
+            }
+        }
+    }
+
+    if (-not [string]::IsNullOrWhiteSpace([string]$Result.ErrorMessage)) {
+        Write-ProcessOutputLine -Message ("{0} error detail: {1}" -f $Stage, $Result.ErrorMessage) -Level "ERROR"
+    }
+}
+
+function Test-PackageDeploymentReadiness {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$PackagePath,
+
+        [Parameter(Mandatory = $true)]
+        [string]$AppName
+    )
+
+    $readiness = @{
+        Ready = $true
+        MissingItems = @()
+    }
+
+    $docsFolder = Join-Path $PackagePath "Docs"
+    if (-not (Test-Path $docsFolder)) {
+        $readiness.Ready = $false
+        $readiness.MissingItems += "Docs folder"
+    }
+    else {
+        $installValidation = Get-ChildItem -Path $docsFolder -File -Filter "* Validation report.html" -ErrorAction SilentlyContinue
+        if (-not $installValidation -or $installValidation.Count -eq 0) {
+            $readiness.Ready = $false
+            $readiness.MissingItems += "Installation validation report (*. Validation report.html in Docs)"
+        }
+
+        $uninstallValidation = Get-ChildItem -Path $docsFolder -File -Filter "Uninstall_Report_*.html" -ErrorAction SilentlyContinue
+        if (-not $uninstallValidation -or $uninstallValidation.Count -eq 0) {
+            $readiness.Ready = $false
+            $readiness.MissingItems += "Uninstallation validation report (Uninstall_Report_*.html in Docs)"
+        }
+    }
+
+    $detectCandidates = @(
+        "{0}_Detect_R1.ps1" -f $AppName,
+        "{0}_Detect_R1.ps1" -f (($AppName -replace '\\s+', '_'))
+    ) | Select-Object -Unique
+
+    $detectFound = $false
+    foreach ($candidate in @($detectCandidates)) {
+        if (Test-Path (Join-Path $PackagePath $candidate)) {
+            $detectFound = $true
+            break
+        }
+    }
+
+    if (-not $detectFound) {
+        $readiness.Ready = $false
+        $readiness.MissingItems += ("Detection script ({0})" -f ($detectCandidates -join " or "))
+    }
+
+    return $readiness
+}
