  <Code><![CDATA[

$formMinsDropDown_Load={
	#TODO: Initialize Form Controls here
	$formMinsDropDown.AutoScaleMode = 'DPI'
	$formMinsDropDown.AutoScale = $false
	$yloc = $parentFormLocY + $goalHeight - 2
	#$yloc = $parentFormLocY + $parentFormHeight - $parentFormHeightCollapse - 2
	$xloc = $parentFormLocX + ($parentFormWidth -$formMinsDropDown.Width)
	$formMinsDropDown.Location = New-Object System.Drawing.Point($xloc , $yloc)
	$buttonOption1.Text = "Update in $option1Text"
	$buttonOption2.Text = "Update in $option2Text"
	$buttonOption3.Text = "Update in $option3Text"
	$script:EndTimeDrop = (Get-Date).AddSeconds(10) # this 'Minutes' is the number of minutes the dialog will stay up. 
	$timerDropDown.Enabled = $true
	$timerDropDown.Interval = 1000 # internval is in milliseconds, so 1000 means a second. 
	$timerDropDown.Start()
	$timerDropDown.add_Tick($timerDropDown_Tick)
	
}


$buttonOption1_Click={
	#TODO: Place custom script here
	$script:optionSelected = 1
	$formMinsDropDown.Close()
}

$buttonOption2_Click={
	#TODO: Place custom script here
	$script:optionSelected = 2
	$formMinsDropDown.Close()
}

$buttonOption3_Click={
	#TODO: Place custom script here
	$script:optionSelected = 3
	$formMinsDropDown.Close()
}

$buttonCloseOptions_Click={
	#TODO: Place custom script here
	$script:MinsCancelSelected = $true
	$formMinsDropDown.Close()
	
}

$timerDropDown_Tick={
	#TODO: Place custom script here
	$spanDrop = $script:EndTimeDrop - (Get-Date)	
	if ($spanDrop.totalseconds -le 0)
	{
		$script:MinsCancelSelected = $true
		$timerDropDown.Stop()
		$formMinsDropDown.Close()
	}
}
]]></Code>
