  <Code><![CDATA[param (
	[Parameter(Mandatory = $false)]
	[switch]$forceReboot = $false,
	[switch]$halted = $false
)

$formCompleted_Load={
	#TODO: Initialize Form Controls here
	
	#Survey option is still in development
	If ($ShowSurvey -eq 0) { $linklSurvey.Visible = $false }
	#Determine Prompt Location
	$Size = [System.Windows.Forms.SystemInformation]::PrimaryMonitorSize
	$xResolution = $Size.Width
	$yResolution = $Size.Height
	$xLocation = $xResolution - 20 - ($formCompleted.Width) #20 pixels from right end of screen	
	$yLocation = 55
	$formCompleted.StartPosition = 'Manual'
	$formCompleted.Location = New-Object System.Drawing.Point($xLocation, $yLocation)
	$Script:formCompletedVertical = 1
	$script:goalHeightComplete = $buttonReportUpdateFailure.Location.Y + $buttonReportUpdateFailure.Height + 2
	$formCompleted.Height = $formCompletedVertical
	
	$timerJobStatus.Start()
	$timerJobStatus.add_Tick($timerJobStatus_Tick)
	$script:EndTime = (Get-Date).AddMinutes(10) # this 'Minutes' is the number of minutes the dialog will stay up. 
	$timerCompleted.Enabled = $true
	$timerCompleted.Interval = 1000 # internval is in milliseconds, so 1000 means a second. 
	$timerCompleted.Start()
	$timerCompleted.add_Tick($timerCompleted_Tick)
	
	# Code below is to spawn the dialog where it doesnt just pop-up, it has a slow drop down effect. 
	# The '$timerFormSpawnCompleted_Tick' is a ticker to spawn the dialog to its max height of 115.
	$timerFormSpawnCompleted.Enabled = $true
	$timerFormSpawnCompleted.Interval = 5
	$timerFormSpawnCompleted.Start()
	$timerFormSpawnCompleted.add_Tick($timerFormSpawnCompleted_Tick)
	#$timerFormSpawnCompleted.Stop() 		
	
	$OS = Get-WmiObject win32_operatingsystem
	$BootTime = $OS.ConvertToDateTime($OS.LastBootUpTime)
	$Uptime = $OS.ConvertToDateTime($OS.LocalDateTime) - $boottime
	$days = $Uptime.Days
	$hours = $Uptime.Hours
	$days = $days.ToString()
	$hours = $hours.ToString()
	$msgwlastreboot = "We are done! You can launch any applications that were closed. We recommend restarting the device but understand if you choose to do so later. The last restart occurred"
	If (($days -le 1) -and ($hours -ge 8))
	{
		$msgCompletion = "$msgwlastreboot $hours hour(s) ago"
	}
	If ($days -ge 1)
	{
		$msgCompletion  = "$msgwlastreboot $days day(s) ago"
	}
	
	if ($halted)
	{
		$labelUpdateComplete.Text = "Installation Halted"
		$msgCompletion = "Notice:A newer version of this software, or a non-standard configuration of the same version, has been detected on your workstation. If you require the version in this attempted install, please uninstall the current version on your machine and start the installation again from the software center."
	}
	if ($forceReboot)
	{
		$buttonOK.Text = 'Restart Now'
		$labelUpdateComplete.Text = "Please Restart"
		$msgCompletion  = "We have finished updating your device but need to restart. You have 10 minutes before it will restart automatically."
		$labelTimeRemaining.Visible = $true
		$label100.Visible = $true
	}
	
	$labelFinishMsg.Text = $msgwlastreboot
		
}

$timerFormSpawnCompleted_Tick = {
	
	If ($script:formCompletedVertical -lt $goalHeightComplete)
	{
		$script:formCompletedVertical = $script:formCompletedVertical + 5
		$formCompleted.Height = $script:formCompletedVertical
		$formCompleted.Refresh()
	}
	Else
	{
		Write-Log "The Completed form spawn completed."
		$formCompleted.Refresh()
		$timerFormSpawnCompleted.Stop()
	}
}


$timerCompleted_Tick = {
	#run force close
	$span = $script:EndTime - (Get-Date)
	$label100.Text = $span.Tostring().Substring(0, 8)
	#$label00.Visible = -not $label00.Visible
	if ($span.totalseconds -le 0)
	{
		Write-Log "Timer on Completed dialog ran out."
		$formCompleted.Close()		
	}
}


$buttonOK_Click={
	#TODO: Place custom script here
	#This will call the OpenProcess dialog
	#$formReturn = Show-OpenProcessPrompt_psf -processlist $OpenProcessesPrompt -PGKR_APPDISPLAYNAME $PKGR_APPDISPLAYNAME -PKGR_MSI_ARPVERSION $PKGR_MSI_ARPVERSION
	Write-Log "USER ACTION: OK button was clicked on the Completed dialog." -Path $PKGR_LogPath -NoConsoleOut -Level
	$formCompleted.Close()
	
#	$jobscheck = (Get-Job -Name LogsCopyJob).State
	<#If ($jobscheck -contains "Running")
	{
		Write-Log "INFO: Logs gathering process still running, calling the Please Wait dialog."
		Show-PleaseWait_psf
	}
	Else
	{
		$formCompleted.Close()
	}#>
}

$buttonReportUpdateFailure_Click = {
	#TODO: Place custom script here

	
	Write-Log "USER ACTION: Report Failure button was clicked on the Completed dialog."
	$ReportIssue = $true
	$formCompleted.Close()
	#	$buttonReportUpdateFailure.Text = "Please Wait"
#	$buttonReportUpdateFailure.Enabled = $false
#	$buttonOK.Enabled = $false
	
	#this section is used twice. Once for code outside of the Job, once for within the Job. best would be to pass the $LogFiles as -Argumelist to StartJob but in future. 
	<#$computer = $Env:COMPUTERNAME
	$domain = (([System.DirectoryServices.ActiveDirectory.Domain]::GetCurrentDomain()).Name).ToLower()
	switch ($domain)
	{
		"rb.win.frb.org"
		{
			$LogFiles = "\\P3PCSM210.rb.win.frb.org\ClientLogs\PCHealth"
		}
		"rbq.winq.frb.org"
		{
			$LogFiles = "\\P3QCSM210.rbq.winq.frb.org\ClientLogs\PCHealth"
		}
	}
	#end duplicate code section
	
	Start-Job -Name LogsCopyJob -ScriptBlock {
		$domain = (([System.DirectoryServices.ActiveDirectory.Domain]::GetCurrentDomain()).Name).ToLower()
		switch ($domain)
		{
			"rb.win.frb.org"
			{
				$LogFiles = "\\P3PCSM210.rb.win.frb.org\ClientLogs\PCHealth"
			}
			"rbq.winq.frb.org"
			{
				$LogFiles = "\\P3QCSM210.rbq.winq.frb.org\ClientLogs\PCHealth"
			}
		}
		
		$computer = $Env:COMPUTERNAME
		$computerA = $ENV:COMPUTERNAME + "-"
		$CMLogs = "$env:Windir\CCM\Logs"
		$CHLog = "$env:ProgramData\EUSClientLogs\Logs"
		$CHLogA = "$env:ProgramData\EUSClientLogs\LogsA"
		$EUSPath = "$env:ProgramData\EUSClientLogs"
		$SetLog = "$env:Windir\ccmsetup\logs"
		
		
		#copy files from local device to server share
		
		if (Test-Path "$EUSPath\$computer.zip" -ErrorAction SilentlyContinue) { Remove-Item "$EUSPath\$computer.zip" }
		if (Test-Path "$LogFiles\$computer.zip" -ErrorAction SilentlyContinue) { Remove-Item "$LogFiles\$computer.zip" }
		if (Test-Path "$CHLog" -ErrorAction SilentlyContinue) { Remove-Item $CHLog -Force -Recurse }
		If ((Get-WmiObject -Class Win32_OperatingSystem -ea 0).OSArchitecture -eq '64-bit')
		{
			$InstallLogs = "${env:CommonProgramFiles(x86)}\InstallLogs"
		}
		else
		{
			$InstallLogs = "$env:CommonProgramFiles\InstallLogs"
		}
		
		
		If (!(Test-Path $CHLog -ErrorAction SilentlyContinue)) { mkdir $CHLog }
		If (!(Test-Path "$CHLog\InstallLogs" -ErrorAction SilentlyContinue)) { mkdir "$CHLog\InstallLogs" }
		If (!(Test-Path "$CHLog\Logs" -ErrorAction SilentlyContinue)) { mkdir "$CHLog\Logs" }
		If (!(Test-Path "$CHLog\CCMSetup" -ErrorAction SilentlyContinue)) { mkdir "$CHLog\CCMSetup" }
		
		systeminfo.exe > "$CHLog\$env:COMPUTERNAME-SysInfo.txt"
		Get-Process | Export-CSV "$CHLog\Processes.csv" -ErrorAction 'SilentlyContinue'
		#Invoke-Command { msinfo32 /report "$CHLog\MSInfo.txt" }
		#Wait-Process -Name msinfo32
		Copy-Item -Path "$env:Windir\WindowsUpdate.log" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
		
		
		If ((Get-WmiObject -Class Win32_OperatingSystem -ea 0).OSArchitecture -eq '64-bit')
		{
			Copy-Item -Path "$env:Windir\Sysnative\winevt\Logs\application.evtx" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
			Copy-Item -Path "$env:Windir\Sysnative\winevt\Logs\system.evtx" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
			Copy-Item -Path "$env:Windir\Sysnative\winevt\Logs\setup.evtx" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
		}
		ELSE
		{
			Copy-Item -Path "$env:Windir\System32\winevt\Logs\application.evtx" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
			Copy-Item -Path "$env:Windir\System32\winevt\Logs\system.evtx" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
			Copy-Item -Path "$env:Windir\System32\winevt\Logs\setup.evtx" -Destination $CHLog -Force -ErrorAction 'SilentlyContinue'
		}
		
		Get-EventLog -LogName Application -Newest 9000 | Export-Csv "$CHLog\Application_log.csv" -ErrorAction 'SilentlyContinue'
		Get-EventLog -LogName System -Newest 9000 | Export-Csv "$CHLog\System_log.csv" -ErrorAction 'SilentlyContinue'
		
		If (Test-Path $SetLog -ErrorAction SilentlyContinue)
		{
			$SetFile = Get-ChildItem $SetLog -Recurse -ErrorAction 'SilentlyContinue'
			foreach ($file in $SetFile)
			{
				Copy-Item $File.FullName "$CHLog\CCMSetup" -Force -ErrorAction 'SilentlyContinue'
			}
		}
		
		
		$appfiles = Get-ChildItem $InstallLogs -Recurse -ErrorAction 'SilentlyContinue' | Where-Object { ($_.lastwritetime | New-TimeSpan) -le "30" } #get logs less than 30 days old
		foreach ($afile in $appfiles)
		{
			Copy-Item $afile.fullname "$CHLog\InstallLogs" -Force -ErrorAction SilentlyContinue
		}
		
		If (Test-Path $CMLogs -ErrorAction SilentlyContinue)
		{
			$CMFiles = Get-ChildItem $CMLogs -Recurse -ErrorAction 'SilentlyContinue' | Where-Object { ($_.LastWriteTime | New-TimeSpan) -le "30" } #get logs less than 30 days old
			foreach ($file in $CMFiles)
			{
				Copy-Item $file.fullname "$CHLog\Logs" -Force -ErrorAction SilentlyContinue
			}
		}
		
		
		
		# use zipfile class after loading
		Add-Type –AssemblyName System.IO.Compression.FileSystem
		#[System.Reflection.Assembly]::LoadWithPartialName('System.IO.Compression.FileSystem')
		[System.IO.Compression.Zipfile]::CreateFromDirectory($CHLog, "$EUSPath\$computer.zip")
		
		Copy-Item -Path "$EUSPath\$computer.zip" -Destination $LogFiles -Force -ErrorAction 'SilentlyContinue'
		
		Remove-Item "$CHLog\CCMSetup" -Force -Recurse
		Remove-Item "$CHLog\InstallLogs" -Force -Recurse
		Remove-Item "$CHLog\Logs" -Force -Recurse
		Get-ChildItem $CHLog -Recurse | Remove-Item -Force -Recurse
		
		
	}
	#EndJob
		
	#------Begin: code provided by NSD-------------
	# Demo of capturing data necessary for utilizing MeToo functionality
	# Author: Caleeh Abdul-Rahmaan (j1cia01)
	# Date Created: 7/7/2017
	
	# Version: 1.1
	# Date Modified: 8/1/2017
	# Update Note: Switched output from SharePoint to Remedy Email Engine. SharePoint code commented out.
	
	# Note: We'd probably wanna send SCCM/EventViewer/Install logs to the DSC first, or possibly 
	# trigger an asynchronous copy script to run on a secondary thread, so this script can confirm 
	# that logs are successfully getting sent before making a ticket.
	
	$LoggedInUser = $(Get-wmiObject -class Win32_ComputerSystem | Select-Object username).username
	$LoggedInUser = $LoggedInUser.Split("\")
	$LoggedInUser = $LoggedInUser[1]
	
	# Creating an empty object to contain our ticket data. 
	$ticketData = New-Object System.Object;
	$ticketData | Add-Member -type NoteProperty -name Title -value "";
	$ticketData | Add-Member -type NoteProperty -name CustomerID -value "";
	$ticketData | Add-Member -type NoteProperty -name Computer -value "";
	$ticketData | Add-Member -type NoteProperty -name IPAddr -value "";
	$ticketData | Add-Member -type NoteProperty -name Network -value "";
	$ticketData | Add-Member -type NoteProperty -name Release -value "";
	$ticketData | Add-Member -type NoteProperty -name SCCMLogsPath -value "";
	
	
	# Setting example release data.
	# Note: All data in this object is in string form and can be set from whatever strings we can obtain from command-line args, environment variables, registry keys, HTTP requests, etc.
	$current_datetime = Get-Date;
	$ticketData.Title = "Customer Reported Issue " + $current_datetime.ToShortDateString() + " @ " + $current_datetime.ToShortTimeString();
	$ticketData.CustomerID = $LoggedInUser;
	$ticketData.Release = "$PKGR_APPDISPLAYNAME" + " - " + "$PKGR_MSI_ARPVERSION" + " - " + "$PKGR_DSCVERSION";
	$ticketData.SCCMLogsPath = $LogFiles + "\" + "$computer.zip";
	
	
	# Getting network data from GetIP
	$GetIP = Invoke-RestMethod -Uri https://devwhosonduty.frb.org/GetIP.aspx;
	$ticketData.Computer = $GetIP.hostname;
	$ticketData.IPAddr = $GetIP.ip;
	$ticketData.Network = $GetIP.network;
	
	$title = $ticketData.Title
	$SCCMLogForWriteFRB = $ticketData.SCCMLogsPath
	$ip = $ticketData.IPAddr
	$netRange = $ticketData.Network
	
	Write-Log "INFO: Title = $title"
	Write-Log "INFO: Customer ID = $LoggedInUser"
	Write-Log "INFO: Release = $PKGR_APPDISPLAYNAME"
	Write-Log "INFO: SCCM Logs Path = $SCCMLogForWriteFRB"
	Write-Log "INFO: Computer Name = $computer"
	Write-Log "INFO: IP Address = $ip"
	Write-Log "INFO: Network Range = $netRange"
	
	# Prepping data to send to SharePoint/MeToo Demo Site, in the "DSCTickets" list
	#$SPData =  "<?xml version='1.0' encoding='utf-8'?>";
	#$SPData += "<soap:Envelope xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'";
	#$SPData += "            xmlns:xsd='http://www.w3.org/2001/XMLSchema'";
	#$SPData += "            xmlns:soap='http://schemas.xmlsoap.org/soap/envelope/'>";
	#$SPData += "    <soap:Body>";
	#$SPData += "        <UpdateListItems xmlns='http://schemas.microsoft.com/sharepoint/soap/'>";
	#$SPData += "            <listName>DSCTickets</listName>";
	#$SPData += "            <updates>";
	#$SPData += "                <Batch OnError='Continue' PreCalc='TRUE' ListVersion='0'>";
	#$SPData += "                    <Method ID='1' Cmd='New'>";
	#$SPData += "                        <Field Name='Title'>"+		$ticketData.Title		+"</Field>";
	#$SPData += "                        <Field Name='_x0062_h13'>"+	$ticketData.CustomerID	+"</Field>";
	#$SPData += "                        <Field Name='ibnb'>"+		$ticketData.Computer	+"</Field>";
	#$SPData += "                        <Field Name='c8ry'>"+		$ticketData.IPAddr		+"</Field>";
	#$SPData += "                        <Field Name='jh9e'>"+		$ticketData.Network		+"</Field>";
	#$SPData += "                        <Field Name='_x0071_mf0'>"+	$ticketData.Release		+"</Field>";
	#$SPData += "                        <Field Name='mdjp'>"+		$ticketData.MasterCRQ	+"</Field>";
	#$SPData += "                    </Method>";
	#$SPData += "                </Batch>";
	#$SPData += "            </updates>";
	#$SPData += "        </UpdateListItems>";
	#$SPData += "    </soap:Body>";
	#$SPData += "</soap:Envelope>";
	
	
	# Sending data to SharePoint/MeToo Demo Site
	# $SPResponse = Invoke-WebRequest -Uri https://fedsharesites.frb.org/nit/FRIT/NATIONALIT/nsd/toolsmgmt/MeToo/_vti_bin/Lists.asmx -Method Post -Body $SPData -ContentType text/xml -UseDefaultCredentials -Verbose -Headers @{"SOAPAction"="http://schemas.microsoft.com/sharepoint/soap/UpdateListItems"}
	
	
	# Sending data to Remedy email engine, with NSD Mailbox CC'd
	$mailFrom = "<kc.national.service.desk@kc.frb.org>";
	$mailTo = "<H1RemedyProd@stls.frb.org>";
	$mailCC = "<nsd@kc.frb.org>";
	$mailSubject = "EUS Software Installation: Issue Report";
	
	$mailBody = $ticketData.CustomerID.ToLower();
	$mailBody += "`r`n";
	$mailBody += "`r`n * Release Name: " + $ticketData.Release;
	$mailBody += "`r`n * Computer Name: " + $ticketData.Computer;
	$mailBody += "`r`n * IP Address: " + $ticketData.IPAddr;
	$mailBody += "`r`n * Network Range: " + $ticketData.Network;
	$mailBody += "`r`n * Logs Path: " + $ticketData.SCCMLogsPath;
	$mailBody += "`r`n";
	$mailBody += "`r`nTicket generated by the Report Failure button.";
	
	Send-MailMessage -From $mailFrom -To $mailTo -Cc $mailCC -Subject $mailSubject -Body $mailBody -SmtpServer "smtp.glc.frb.org";
	#>
	#------End: code provided by NSD-------------

}



