<File version="3.2">
  <Code><![CDATA[#region Param for debugging
param
(
	[Parameter(Position = 0)]
	[string]$ArgString
)

# The ArgString parameter is for debugging; it is not use once packaged to an EXE.
# Packaged scripts use a single string of passed command line parameters. See the Main function Commandline parameter.

if (($PSBoundParameters['ArgString']) -and ($null -eq $Commandline)) { $Commandline = $ArgString }
#endregion

function Main
{
<#
    .SYNOPSIS
        The Main function starts the project application.

    .PARAMETER Commandline
        $Commandline contains the complete argument string passed to the script packager executable.

    .NOTES
        Use this function to initialize your script and to call GUI forms.

    .NOTES
        To get the console output in the Packager (Forms Engine) use:
		$ConsoleOutput (Type: System.Collections.ArrayList)
#>
	## ZeroConfig.ps1 importation is done in Globals 
	
	Param ([String]$Commandline)
	
	##*===============================================
	##* VARIABLE DECLARATION
	##*===============================================
	[version]$version = 1.0.0
	## Variables: Application
	[string]$appVendor = 'Lucen Software'
	[string]$appName = 'Timeline'
	[string]$appNameMask = 'Timeline'
	[string]$appVersion = '14.19.0'
	[string]$appGUID = ''
	[string]$appInstallerExeName = ''
	[string]$appUninstallExeName = ''
	[string]$appMsiName = 'LucenTimeline.msi'
	[string]$appMstName = ''
	[string]$appScriptAuthor = 'Andrews, Marcus'
	[version]$appScriptBuildVersion = '1.0.5'
	[string]$appInstallCommandLine = ''
	[string]$appUninstallCommandLine = ''
	[string]$appStopRequiredProcesses = '' # any executables that need be closed prior to an install EXAMPLE: Notepad,notepad.exe,true;
	[string]$installContext = 'User' # shows what context this app should run in; System or User
	[boolean]$appPrompt = $false
	[boolean]$appReboot = $false
	
	##*===============================================
	##* END VARIABLE DECLARATION
	##*===============================================
	
	#region [Zero-Config]
	## Purpose: Synchronize variables with values from ZeroConfig.ps1, prioritizing non-empty hashtable values
	foreach ($key in $zc.Keys)
	{
		# Get existing variable value if it exists
		$variableValue = Get-Variable -Name $key -ErrorAction SilentlyContinue |
		Select-Object -ExpandProperty Value
		
		# Get hashtable value
		$hashtableValue = $zc[$key]
		
		# Determine which value to use (prioritizing hashtable value if not empty)
		if (![string]::IsNullOrEmpty($hashtableValue))
		{
			$valueToUse = $hashtableValue
		}
		else
		{
			$valueToUse = $variableValue
		}
		
		# Update the variable with the determined value
		Set-Variable -Name $key -Value $valueToUse -ErrorAction Continue
	}
	
	## If the default Startup.pss hasn't been modified, check for MSI / MST and modify the install accordingly
	If (-not $appName)
	{
		# Set temporary log catcher
		[string[]]$tempLog = $null
		# Build properly formatted Architecture String
		switch ($Is64Bit)
		{
			$false { $formattedOSArch = "x86" }
			$true { $formattedOSArch = "x64" }
		}
		#  Find the first MSI file in the Files folder and use that as our install
		if ([string]$defaultMsiFile = (Get-ChildItem -LiteralPath $dirFiles -ErrorAction 'SilentlyContinue' | Where-Object { (-not $_.PsIsContainer) -and ([IO.Path]::GetExtension($_.Name) -eq ".msi") -and ($_.Name.EndsWith(".$formattedOSArch.msi")) } | Select-Object -ExpandProperty 'FullName' -First 1))
		{
			$tempLog += "Discovered $formattedOSArch Zerotouch MSI under $defaultMSIFile"
		}
		elseif ([string]$defaultMsiFile = (Get-ChildItem -LiteralPath $dirFiles -ErrorAction 'SilentlyContinue' | Where-Object { (-not $_.PsIsContainer) -and ([IO.Path]::GetExtension($_.Name) -eq ".msi") } | Select-Object -ExpandProperty 'FullName' -First 1))
		{
			$tempLog += "Discovered Arch-Independent Zerotouch MSI under $defaultMSIFile"
		}
		If ($defaultMsiFile)
		{
			Try
			{
				[boolean]$useDefaultMsi = $true
				$tempLog += "Discovered Zero-Config MSI installation file [$defaultMsiFile]."
				#  Discover if there is a zero-config MST file
				[string]$defaultMstFile = [IO.Path]::ChangeExtension($defaultMsiFile, 'mst')
				If (Test-Path -LiteralPath $defaultMstFile -PathType 'Leaf')
				{
					$tempLog += "Discovered Zero-Config MST installation file [$defaultMstFile]."
				}
				Else
				{
					[string]$defaultMstFile = ''
				}
				#  Discover if there are zero-config MSP files. Name multiple MSP files in alphabetical order to control order in which they are installed.
				[string[]]$defaultMspFiles = Get-ChildItem -LiteralPath $dirFiles -ErrorAction 'SilentlyContinue' | Where-Object { (-not $_.PsIsContainer) -and ([IO.Path]::GetExtension($_.Name) -eq '.msp') } | Select-Object -ExpandProperty 'FullName'
				If ($defaultMspFiles)
				{
					$tempLog += "Discovered Zero-Config MSP installation file(s) [$($defaultMspFiles -join ',')]."
				}
				
				## Read the MSI and get the installation details
				[hashtable]$GetDefaultMsiTablePropertySplat = @{ Path = $defaultMsiFile; Table = 'Property'; ContinueOnError = $false; ErrorAction = 'Stop' }
				If ($defaultMstFile) { $GetDefaultMsiTablePropertySplat.Add('TransformPath', $defaultMstFile) }
				[psobject]$defaultMsiPropertyList = Get-MsiTableProperty @GetDefaultMsiTablePropertySplat
				[string]$appVendor = $defaultMsiPropertyList.Manufacturer
				[string]$appName = $defaultMsiPropertyList.ProductName
				# Cast MSI version as version if its a valid type
				$appVersion = $defaultMsiPropertyList.ProductVersion
				Write-Log -Message "MSI appVersion : $appVersion[$($appVersion.GetType().Name)]"
				[string]$appGUID = $defaultMsiPropertyList.ProductCode
				$GetDefaultMsiTablePropertySplat.Set_Item('Table', 'File')
				[psobject]$defaultMsiFileList = Get-MsiTableProperty @GetDefaultMsiTablePropertySplat
				[string[]]$defaultMsiExecutables = Get-Member -InputObject $defaultMsiFileList -ErrorAction 'Stop' | Select-Object -ExpandProperty 'Name' -ErrorAction 'Stop' | Where-Object { [IO.Path]::GetExtension($_) -eq '.exe' } | ForEach-Object { [IO.Path]::GetFileNameWithoutExtension($_) }
				[string]$defaultMsiExecutablesList = $defaultMsiExecutables -join ','
				$tempLog += "App Vendor [$appVendor]."
				$tempLog += "App Name [$appName]."
				$tempLog += "App Version [$appVersion]."
				$tempLog += "MSI Executable List [$defaultMsiExecutablesList]."
			}
			Catch
			{
				$tempLog += "Failed to process Zero-Config MSI Deployment. `n$(Resolve-Error)"
				$useDefaultMsi = $false; $appVendor = ''; $appName = ''; $appVersion = ''
			}
		}
		# Check to see if JSON is in the Data folder
		IF (Test-Path "$dirFiles\zeroConfig*.json")
		{
			$jsonContent = Get-Content -Path "$dirFiles\zeroConfig*.json" -Raw -ErrorAction SilentlyContinue | ConvertFrom-Json 
		}

		if ($jsonContent)
		{
			#Determine Installer Name from JSON property appInstallerExeName or appInstallerEXeRegex
			if (($jsonContent.Apps[0]).appInstallerExeName -ne '')
			{
				$appInstallerExeName = ($jsonContent.Apps[0]).appInstallerExeName
			}
			Elseif (($jsonContent.Apps[0]).appInstallerExeRegex -ne '')
			{
				Try
				{
					$appInstallerExeName = (Get-ChildItem -Path $dirFiles | Where-Object { $_.Name -match ($jsonContent.Apps[0]).appInstallerExeRegex }).Name
				}
				catch
				{
					Write-Log -Message "Unable to find specified installer in $dirFiles " -Severity 3 -LogType CMTrace
					Exit-Script 1
				}
			}
			#Verify number of installers
			[array]$installSequence = @()
			Foreach ($app in $jsonContent.Apps)
			{
				If (Test-Path -Path "$dirFiles\$($app.appInstallerExeName)") { $installSequence += $app }
			}
			# For Single Installer, populate package variables 
			if ($installSequence.Count -eq 1)
			{
				if (($jsonContent.Apps[0]).appVendor -ne '') { $appVendor = ($jsonContent.Apps[0]).appVendor }
				if (($jsonContent.Apps[0]).appName -ne '') { $appName = ($jsonContent.Apps[0]).appName }
				if (($jsonContent.Apps[0]).appGUID -ne '') { $appGUID = ($jsonContent.Apps[0]).appGUID }
				if ((($jsonContent.Apps[0]).appNameRegex -ne '') -and (($appInstallerExeName -match ($jsonContent.Apps[0]).appNameRegex)))
				{
					$appName = $($Matches[1])
				}
				if (($jsonContent.Apps[0]).appGUID -ne '') { $appGUID = ($jsonContent.Apps[0]).appGUID }
				if (($jsonContent.Apps[0]).appVersion -ne ''){
					$appVersion = ($jsonContent.Apps[0]).appVersion
					Write-Log -Message "JSON appVersion : $appVersion[$($appVersion.GetType().Name)]"
				}
				if ((($jsonContent.Apps[0]).appVersionRegex -ne '') -and (($appInstallerExeName -match ($jsonContent.Apps[0]).appVersionRegex)))
				{
					$appVersion = $($Matches[1])
				}
				if (($jsonContent.Apps[0]).appInstallCommandLine -ne '') { $appInstallCommandLine = ($jsonContent.Apps[0]).appInstallCommandLine }
				if (($jsonContent.Apps[0]).appUninstallExeName -ne '') { $appUninstallExeName = ($jsonContent.Apps[0]).appUninstallExeName }
				if (($jsonContent.Apps[0]).appUninstallCommandLine -ne '') { $appUninstallExeNameRegex = ($jsonContent.Apps[0]).appUninstallCommandLine }
				if (($jsonContent.Apps[0]).appStopRequiredProcesses -ne '') { $appStopRequiredProcesses = ($jsonContent.Apps[0]).appStopRequiredProcesses }
				if (($jsonContent.Apps[0]).appInstallDir -ne '') { $appInstallDir = ($jsonContent.Apps[0]).appInstallDir }
				if (($jsonContent.Apps[0]).appInstallRemoveFiles -ne '') { $appInstallRemoveFiles = ($jsonContent.Apps[0]).appInstallRemoveFiles }
				if (($jsonContent.Apps[0]).appUninstallRemoveFiles -ne '') { $appInstallRemoveFiles = ($jsonContent.Apps[0]).appUninstallRemoveFiles }
				if (($jsonContent.Apps[0]).appActiveSetup -ne '') { $appActiveSetup = ($jsonContent.Apps[0]).appActiveSetup }
				#Override Vendor, AppName, AppVersion values with Global Property
				if ($jsonContent.globalAppVendor -ne '') { $appVendor = $jsonContent.globalVendor }
				if ($jsonContent.globalAppName -ne '') { $appName = $jsonContent.globalAppName }
				if ($jsonContent.globalAppVersion -ne '') { 
					$appVersion = $jsonContent.globalAppVersion 
					Write-Log -Message "JSON appVersion : $appVersion[$($appVersion.GetType().Name)]"
				}
		
			}
			Else
			{
				#Multiple Installers must use Global JSON App Properties
				if ($jsonContent.globalAppVendor -ne '') { $appVendor = $jsonContent.globalVendor }
				if ($jsonContent.globalAppName -ne '') { $appName = $jsonContent.globalAppName }
				if ($jsonContent.globalAppVersion -ne '') { 
					$appVersion = $jsonContent.globalAppVersion
					Write-Log -Message "JSON appVersion : $appVersion[$($appVersion.GetType().Name)]"
				}
				if (($appName -eq '') -or ($appVersion -eq ''))
				{
					Write-Log -Message "Multiple Installs require global json properties to be defined." -Severity 3 -LogType CMTrace
					Exit-Script 1
				}
			}
			
		}
		else
		{
			Write-Log -Message "JSON was not found. Using PS1" -LogType CMTrace
		}
	}
	
	# Cast appVersion as version if its a valid version value
	IF ($appVersion -and (Start-TryParse -VersionString $appVersion))
	{
		# Convert imported value to version
		Write-Log -Message "Converting AppVersion to [version]"
		$version = [System.Version]::Parse($appVersion)
		# Cast $appVersion as version
		[version]$appVersion = $version
	}
	
	#endregion
	
	#region Build the Installation Name
	[String]$installName = $appVendor + '_' + $appName + '_' + $appVersion
	
	#endregion Build the Installation Name
	
	#region [Switch Variables]
	If (($appPrompt -eq $true) -or ($appReboot -eq $true))
	{
		$global:PromptedInstall = 1
	}
	
	IF ($installContext -match 'user')
	{
		$configToolkitRequireAdmin = $false
		$configMSILogDir = "$env:TEMP\InstallLogs"
		$configToolkitLogDir = "$env:TEMP\InstallLogs"
	}
	
	
	# Check for uninstall param and Build Log Filename
	$uninstall = $false
	[string]$logName = "PSI_$appName`-$appVersion`-$appScriptBuildVersion.log"
	if (($Commandline.ToLower().Contains("/uninstall")))
	{
		$uninstall = $true
		$logName = $logName -replace 'PSI_', 'PSI_UNINST_'
	}
	
	#endregion
	
	#region [Intune Content Caching]
	
	if ($scriptRoot -match [regex]::Escape("$env:windir\IMEcache"))
	{
		$Script:Phase = 'Intune Content Caching'
		Copy-ContentToCache
	}
	
	#endregion [Intune Content Caching]
	
	#region Determine Quarter
	$quarter = Get-QuarterInfo
	#endregion Determine Quarter

	#region [System Information]
	$script:Phase = 'System Information'
	$sysInfo = Get-SystemInformation

	# Running Mutex check to see if there are other Installs currently running
	Set-PsadtAppLock
	
	# Log values
	Write-Log -Message "appVendor: $appVendor"
	Write-Log -Message "appName : $appName"
	Write-Log -Message "Mask Name : $appNameMask"
	Write-Log -Message "Version : $appVersion"
	Write-Log -Message "appVersion : $appVersion[$($appVersion.GetType().Name)]"
	Write-Log -Message "GUID : $appGUID"
	Write-Log -Message "Install EXE : $appInstallerExeName"
	Write-Log -Message "Uninstall EXE : $appUninstallExeName"
	Write-Log -Message "MSI : $appMsiName"
	Write-Log -Message "MST : $appMstName"
	Write-Log -Message "Packager : $appScriptAuthor"
	Write-Log -Message "Build Version : $appScriptBuildVersion"
	Write-Log -Message "Install CommandLine : $appInstallCommandLine"
	Write-Log -Message "Uninstall CommandLine : $appUninstallCommandLine"
	Write-Log -Message "Stop Processes : $appStopRequiredProcesses"
	#endregion [System Information]
	
	#region [ZC Logging]
	if ($tempLog)
	{
		Write-Log -Message $tempLog -LogType CMTrace -ScriptSection 'Zero-Config'
	}
	#endregion
	
	#region [Prompts]
	$Script:Phase = 'Initial Prompts'
	If (($Commandline.ToLower().Contains("/prompt")) -or ($Commandline.ToLower().Contains("/reboot")))
	{
		$global:PromptedInstall = 1
		If ($Commandline.ToLower().Contains("/reboot"))
		{
			Show-InstallInformation_psf -AppName $appName -AppVersion $appVersion -appStopRequiredProcesses $appStopRequiredProcesses -processlist $OpenProcessesPrompt -forceReboot
		}
		Else
		{
			Show-InstallInformation_psf -AppName $appName -AppVersion $appVersion -appStopRequiredProcesses $appStopRequiredProcesses -processlist $OpenProcessesPrompt
		}
	}
	Elseif (($null -ne $appStopRequiredProcesses) -and ($appStopRequiredProcesses -ne [string]::Empty))
	{
		Check-StopProcesses -appName $appName -appVersion $appVersion -appStopRequiredProcesses $appStopRequiredProcesses
	}

	If ($global:PromptedInstall -eq 1)
	{
		Write-Log -Message "Calling the Progress prompt." -LogType 'CMTrace'
		If ($Commandline.ToLower().Contains("/reboot"))
		{
			Start-Process -FilePath "$dirFiles\EUSInstallProgress.exe" -ArgumentList "/reboot" -WorkingDirectory "$dirFiles"
		}
		Else
		{
			Start-Process -FilePath "$dirFiles\EUSInstallProgress.exe" -WorkingDirectory "$dirFiles"
		}
	}
	
	#endregion [Prompts]
	
	If (-not $uninstall)
	{

		##*===============================================
		##* PRE-INSTALLATION
		##*===============================================
		$Script:Phase = 'Pre-Installation'
		#region Uninstall previous versions
		Write-Log -Message "Checking for previous versions" -LogType 'CMTrace'
		If ($appNameMask -eq '')
		{
			$appNameMask = $appName
			if ($appNameMask -match '\d')
			{
				Write-Log -Message "[$appNameMask] possibly contains versioning information. This may affect previous version removals and Detection Method." -LogType CMTrace -Severity 2
			}
		}
		$arpApps = Get-InstalledApplication -Name $appNameMask
		Foreach ($arpApp in $arpApps)
		{
			$removeDisplayName = $arpApp | Select-Object -expand DisplayName
			$removeDisplayVersion = $arpApp | Select-Object -expand DisplayVersion
			Write-Log -Message "Found version: $removeDisplayVersion" -LogType 'CMTrace'
			# We only want to remove previous versions if they are older than the current version
			if ($removeDisplayVersion -lt $appVersion)
			{
				if (($arpApp | Select-Object -expand UninstallString).ToLower() -like "*msiexec.exe*")
				{
					$removeGUID = $arpApp | Select-Object -expand ProductCode
					Write-Log -Message "Removing previous version MSI $removeDisplayName $removeDisplayVersion" -LogType 'CMTrace'
					Execute-MSI -Action 'Uninstall' -Path $removeGUID -LogName "$removeDisplayName`-$removeDisplayVersion"
				}
				Else
				{
					# Customize this section based on the UninstallString entry of the Uninstall registry key
					$UninstallString = $arpApp | Select-Object -expand UninstallString
					$UninstallCommand, $UninstallArgs = $UninstallString.split('/')
					$UninstallCommand = $UninstallCommand.replace('"', '')
					$UninstallCommand = $UninstallCommand.trim()
					Write-Log -Message "Removing previous version SETUP $removeDisplayName $removeDisplayVersion" -LogType 'CMTrace'
					if (-not ($appUninstallCommandLine))
					{
						[string]$appUninstallCommandLine = '/uninstall /quiet /norestart'
					}
					Execute-Process -Path $UninstallCommand -Parameters "$appUninstallCommandLine /log `"$configToolkitLogDir\SETUP_UNINST_$removeDisplayName`-$removeDisplayVersion.log`"" -WindowStyle 'Hidden'
				}
			}
			if (($removeDisplayVersion -gt $appVersion) -and ($PromptedInstall -eq 1))
			{
				Show-InstallCompleted_psf -halted
				Exit-Script -ExitCode 0
			}
		}
		#endregion

		## <Perform Pre-Installation tasks here>

		##*===============================================
		##* INSTALLATION
		##*===============================================
		$Script:Phase = 'Installation'

		#region Handle Zero-Config MSI Installations
		If ($useDefaultMsi)
		{
			[hashtable]$ExecuteDefaultMSISplat = @{ Action = 'Install'; Path = $defaultMsiFile; LogName = "$appName`-$appVersion`-$appScriptBuildVersion" };
				If ($defaultMstFile) { $ExecuteDefaultMSISplat.Add('Transform', $defaultMstFile) };
				If ($appInstallCommandLine) { $ExecuteDefaultMSISplat.Add('AddParameters', $appInstallCommandLine) }
			Execute-MSI @ExecuteDefaultMSISplat; If ($defaultMspFiles) { $defaultMspFiles | ForEach-Object { Execute-MSI -Action 'Patch' -Path $PSItem } }
		}
		#endregion

		#region <Perform Installation tasks here>

		# LucenTimeline User-Context Installation Script
# Run as: Standard User (no admin required)
$ScriptDir = if ($PSScriptRoot) { $PSScriptRoot } else { Get-Location }
$MsiPath = Join-Path $ScriptDir "Data\LucenTimeline.msi"
$MsiExec = "$env:SystemRoot\System32\msiexec.exe"
Write-Host "Installing Lucen Timeline (User Context) from: $MsiPath"
if (-not (Test-Path $MsiPath)) {
Write-Error "MSI file not found: $MsiPath"
exit 1
}
# User-context installation (no /qn needed, but keeping for consistency)
$Process = Start-Process -FilePath $MsiExec -ArgumentList "/i `"$MsiPath`" /qn WITHFIRSTRUNSEQUENCE=0
DISABLECHECKFORUPDATES=1 REBOOT=ReallySuppress" -Wait -NoNewWindow -PassThru

















		## Installer is MSI
		Try
		{
			If ($appMsiName)
			{
				[hashtable]$ExecuteMSISplat = @{ Action = 'Install'; Path = $appMsiName; LogName = "$appName`-$appVersion`-$appScriptBuildVersion" };
				If ($appMstName) { $ExecuteMSISplat.Add('Transform', $appMstName) };
				If ($appInstallCommandLine) { $ExecuteMSISplat.Add('AddParameters', $appInstallCommandLine) }
				Execute-MSI @ExecuteMSISplat
			}
			ElseIf ($appInstallerExeName)
			{
				Execute-Process -Path $appInstallerExeName -Parameters $appInstallCommandLine -WindowStyle 'Hidden'
			}
		}
		Catch
		{
			Stop-Process 'EUSInstallProgress' -Force -ErrorAction SilentlyContinue
			Write-Log -Message "$appName $appVersion failed to install. Exiting Installation" -LogType 'CMTrace'
		}
		#endregion

		##*===============================================
		##* POST-INSTALLATION
		##*===============================================
		$Script:Phase = 'Post-Installation'

		## <Perform Post-Installation tasks here>

		##*===============================================
		##* END-INSTALLATION
		##*===============================================
		$Script:Phase = 'End-Installation'

		Write-Log -Message 'End of Installation' -LogType 'CMTrace'

	}
	ElseIf ($uninstall)
	{

		##*===============================================
		##* PRE-UNINSTALLATION
		##*===============================================
		$Script:Phase = 'Pre-Uninstallation'

		## <Perform Pre-Uninstallation tasks here>

		##*===============================================
		##* UNINSTALLATION
		##*===============================================
		$Script:Phase = 'Uninstallation'

		#region Handle Zero-Config MSI Uninstallations
		If ($useDefaultMsi)
		{
			[hashtable]$ExecuteDefaultMSISplat = @{ Action = 'Uninstall'; Path = $defaultMsiFile; LogName = "$appName`-$appVersion`-$appScriptBuildVersion" };
				If ($defaultMstFile) { $ExecuteDefaultMSISplat.Add('Transform', $defaultMstFile) };
				If ($appUninstallCommandLine) { $ExecuteDefaultMSISplat.Add('AddParameters', $appUninstallCommandLine) }
			Execute-MSI @ExecuteDefaultMSISplat
		}
		#endregion

		#region <Perform Uninstallation tasks here>

		# LucenTimeline User-Context Uninstallation Script
# Run as: Standard User (no admin required)
$MsiExec = "$env:SystemRoot\System32\msiexec.exe"
Write-Host "Searching for Lucen Timeline installation (User Context)..."
# Check HKCU for user-context installation
$UninstallKey = Get-ItemProperty "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*" |
Where-Object { $_.DisplayName -like "*Timeline*" } | Select-Object -ExpandProperty PSChildname
if (-not $UninstallKey) {
	Write-Warning "Lucen Timeline is not installed for current user."
	exit 0
}
# Uninstall from user context
$Process = Start-Process -FilePath $MsiExec -ArgumentList "/x $UninstallKey /qn REBOOT=ReallySuppress" -Wait

Remove-Item -Path
"HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\{3CD22777-7C9B-4DB8-ACEE-D5D0DD6EFEF5}"
-Recurse -Force
























		## Uninstaller is Setup
		# Customize based on the setup executable uninstall command line switches
		Try
		{
			If ($appUninstallExeName)
			{
				Execute-Process -Path $appUninstallExeName -Parameters $appUninstallCommandLine -WindowStyle 'Hidden' -ErrorAction Stop
			}
			ElseIf ($appGUID)
			{
				Execute-MSI -Action 'Uninstall' -Path $appGUID -LogName "$appName`-$appVersion`-$appScriptBuildVersion" -ErrorAction Stop
			}
		}
		Catch
		{
			Stop-Process 'EUSInstallProgress' -Force -ErrorAction SilentlyContinue
			Write-Log -Message "$appName $appVersion failed to uninstall. Exiting Uninstall" -LogType 'CMTrace'
		}

		#Execute-Process -Path 'Setup.exe' -Parameters "/uninstall /quiet /norestart /log `"$configToolkitLogDir\SETUP_UNINST_$appName`-$appVersion`-$appScriptBuildVersion.log`"" -WindowStyle 'Hidden'
		#endregion

		##*===============================================
		##* POST-UNINSTALLATION
		##*===============================================
		$Script:Phase = 'Post-Uninstallation'

		## <Perform Post-Uninstallation tasks here>



		##*===============================================
		##* END-UNINSTALLATION
		##*===============================================
		$Script:Phase = 'End-Uninstallation'

		Write-Log -Message 'End of Uninstallation' -LogType 'CMTrace'

	}
	
	# Clean up cache content if exist
	if (Test-Path -Path "$configToolkitCachePath\$installName")
	{
		Remove-ContentFromCache
	}
	
	If ($global:PromptedInstall -eq 1)
	{
		Stop-Process -Name "EUSInstallProgress" -Force -ErrorAction SilentlyContinue
		If (!($Commandline.ToLower().Contains("/reboot")))
		{
			Write-Log -Message "Calling the Complete prompt." -LogType 'CMTrace'
			Show-InstallCompleted_psf
		}
		ElseIf ($Commandline.ToLower().Contains("/reboot"))
		{
			If (!($Commandline.ToLower().Contains("sccm")))
			{
				Write-Log -Message "Calling the RebootComplete prompt." -LogType 'CMTrace'
				Show-InstallCompleted_psf -forceReboot
				Restart-Computer -Force
			}
Else
			{
			Write-Log -Message "Exiting script with Exit Code 3010" -LogType 'CMTrace'
			Exit-Script -ExitCode 3010
		}
	}
}

	##*===============================================
	##* END SCRIPT BODY
	##*===============================================
}
