  <Code><![CDATA[param (
	[Parameter(Mandatory = $true)]
	$appName,
	$appVersion,
	$processlist,
	$appStopRequiredProcesses,	
	[switch]$forceReboot = $false
)

$formSTD1_Hello_Load = {
	#Initialize Form Controls 	
	Write-Log -Message "Setting PromptedInstall to 1." -LogType 'CMTrace'
	$global:PromptedInstall = 1
	$formSTD1_Hello.AutoScaleMode = 'DPI'
	$formSTD1_Hello.AutoSize = $false
	$script:continueNowHello = $false
	$buttonMinimize.Visible = $true ### Changed
	$labelAppInfo.Text = "$appName $appVersion"
	If ($forceReboot)
	{
		$labelUpdateAvailable.Text = "Update and Restart Required"
		$labelCloseAppMsg.Text = "Hello! We are updating your device and will need to RESTART IMMEDIATELY AFTER. Please save and close all apps before proceeding."
		$labelWillAskYouToClose.Visible = $false
		$labelprocesslist.Visible=$false
	}
	
	if ($appName.Contains($appVersion)){$labelAppInfo.Text = $appName}
	$labelprocesslist.Text = Format-FRBProcesses -appStopRequiredProcesses $appStopRequiredProcesses
	#--Set form location
	$Size = [System.Windows.Forms.SystemInformation]::PrimaryMonitorSize
	$xResolution = $Size.Width
	$yResolution = $Size.Height
	$xLocation = $xResolution - 20 - ($formSTD1_Hello.Width)
	$yLocation = 55 
	$Script:parentFormLocX = $xLocation
	$Script:parentFormLocY = $yLocation
	$Script:parentFormWidth = $formSTD1_Hello.Width
	$Script:parentFormHeight = $formSTD1_Hello.Height
	#--Play Sound
	$sound = new-Object System.Media.SoundPlayer;
	$sound.SoundLocation = "c:\WINDOWS\Media\notify.wav";
	$sound.Play();
	$formSTD1_Hello.StartPosition = 'Manual'
	$formSTD1_Hello.Location = New-Object System.Drawing.Point($xLocation, $yLocation)
	$Script:formHelloVertical = $formSTD1_Hello.Size.Height
	$script:goalHeight = $buttonDelay.Location.Y + $buttonDelay.Height + 2
	Write-Log -Message "Initial Goal Height Hello = $goalHeight"
	$formSTD1_Hello.Height = $formHelloVertical
	$Script:parentFormHeightCollapse = $buttonDelay.Location.Y + $buttonDelay.Height
	#--Initiate and start timer
	$script:DialogTimingConfig = Get-DialogTimingConfig
	$script:EndTime = (Get-Date).AddMinutes($script:DialogTimingConfig.InstallInformationTimeoutMinutes) # this 'Minutes' is the number of minutes the dialog will stay up.
	$timerHello.Enabled = $true
	$timerHello.Interval = 1000 # internval is in milliseconds, so 1000 means a second. 
	$timerHello.Start()
	$timerHello.add_Tick($timerHello_Tick)	
}

$timerHello_Tick = {
	#run force close
	$script:span = $script:EndTime - (Get-Date)
	If ($buttonDelay.Enabled -eq $false)
	{
		$formSTD1_Hello.Height = $formHelloVertical
		$labelTimer.Text = $span.Tostring().Substring(0, 8)
	}
	If ($span.totalseconds -le 60)
	{
		$formSTD1_Hello.Height = $formHelloVertical
		$labelprocesslist.Text = Format-FRBProcesses -appStopRequiredProcesses $appStopRequiredProcesses
		$formSTD1_Hello.WindowState = 'Normal'
		$buttonMinimize.Visible = $false		
	}
	If ($span.totalseconds -le 0)
	{
		
		#this optin will be selected when user does not respond and the timer runs out. User has not made a decision. So the app will choose the highest possible delay for the user
		Write-Log -Message "Hello timer is now 0 seconds."
		If (($buttonDelay.Enabled -eq $true) -and !$timedelayset)
		{
		
			Write-Log -Message "Since timer ran out and no action was taken on Hello dialog, largest time option is automatically chosen."
			$script:timeSelected = 120
			If ($forceReboot)
			{
				$script:timeSelected = 180
			}
			$timedelayset=$true
			$script:EndTime = (Get-Date).AddMinutes($timeSelected) # this 'Minutes' is the number of minutes the dialog will stay up. 
			$script:span = $script:span + ($script:EndTime - (Get-Date))
			$labelBackInAnother.Visible = $false
			$labelMinutes.Visible = $false
			$displayTimeUnit = 'minutes'
			[string]$displayTimeSelected = $timeSelected
			If ($forceReboot)
			{
				$displayTimeUnit = 'hour(s)'
				[string]$displayTimeSelected= ($timeSelected/60)
			}
			$labelCloseAppMsg.Text = "Hello! The update has been delayed for $displayTimeSelected $displayTimeUnit. Please close any open application(s) to continue."

			
			
			$buttonDelay.Enabled = $false
			$buttonDelay.ForeColor = $ButtonDisableColor
			$formSTD1_Hello.TopMost = $false
			$buttonMinimize.Visible = $true
		}
		Else
		{
			Write-Log -Message "Hello Timer expired and closing hello form."
			$timerHello.Stop()
			$formSTD1_Hello.Close()
		}
		
		
		<#Else
		{
			$timerHello.Stop()
			$formHello.Close()
		}#>
		
	}
}


$buttonContinueNow_Click={
	#TODO: Place custom script here
	Write-Log -Message "USER ACTION: Continue Now button was clicked on the Hello dialog."
	$script:continueNowHello = $true
	$formSTD1_Hello.Close()
}


$buttonDelay_Click={
	#TODO: Place custom script here
	# This will sleep for the #of minutes and come back with the "Reminder" dialog.
	$script:DialogTimingConfig = Get-DialogTimingConfig
	$script:delayOptionsMinutes = $script:DialogTimingConfig.DelayOptionsNormalMinutes
	$script:option1Text = "$($script:delayOptionsMinutes[0]) Minutes"
	$script:option2Text = "$($script:delayOptionsMinutes[1]) Minutes"
	$script:option3Text = "$($script:delayOptionsMinutes[2]) Minutes"
	if ($forceReboot)
	{
		$script:delayOptionsMinutes = $script:DialogTimingConfig.DelayOptionsForceRebootMinutes
		$script:option1Text = "$([math]::Round($script:delayOptionsMinutes[0] / 60, 1)) hour"
		$script:option2Text = "$([math]::Round($script:delayOptionsMinutes[1] / 60, 1)) hours"
		$script:option3Text = "$([math]::Round($script:delayOptionsMinutes[2] / 60, 1)) hours"
	}
	$buttonContinueNow.BackColor = $ButtonDisableColor
	$buttonDelay.BackColor = $ButtonDisableColor
	$formSTD1_Hello.Height = $goalHeight
	if ((Show-TimeDelayOptions_psf) -eq 'OK'){}
	$buttonContinueNow.BackColor = $ButtonEnableColor
	$buttonDelay.BackColor = $ButtonEnableColor
	If (!$MinsCancelSelected)
	{
		switch ($optionSelected)
		{
			1	{ $timeSelected = $script:delayOptionsMinutes[0] }
			2 	{ $timeSelected = $script:delayOptionsMinutes[1] }
			3  	{ $timeSelected = $script:delayOptionsMinutes[2] }
		}

		If ($optionSelected)
		{
			$buttonDelay.BackColor = $ButtonDisableColor
			$timedelayset = $true
		}
		$optionSelected=''
		$script:EndTime = (Get-Date).AddMinutes($timeSelected) # this 'Minutes' is the number of minutes the dialog will stay up. 
		$script:span = $script:span + ($script:EndTime - (Get-Date))
		$buttonDelay.Enabled = $false
		$buttonDelay.ForeColor = $ButtonDisableColor
		$displayTimeUnit = 'minutes'
		If ($forceReboot)
		{
			$displayTimeUnit = 'hour(s)'
			[string]$displayTimeSelected = ($timeSelected/60)
		}
		$labelCloseAppMsg.Text = "Hello! The update has been delayed for $displayTimeSelected $displayTimeUnit. Please close any open application(s) to continue."
		$formSTD1_Hello.TopMost = $false
		$formSTD1_Hello.WindowState = 'Minimized'
		$buttonMinimize.Visible = $true		
	}
	Else
	{
		$script:MinsCancelSelected = $false
		$formSTD1_Hello.Height = $formHelloVertical		
	}
	
	Write-Log -Message "USER ACTION: Come back later button was clicked on the Hello dialog with $displayTimeSelected $displayTimeUnit option selected ."
}


$buttonMinimize_Click = {
	#TODO: Place custom script here
	$formSTD1_Hello.WindowState = 'Minimized'
}


$formSTD1_Hello_FormClosing=[System.Windows.Forms.FormClosingEventHandler]{
#Event Argument: $_ = [System.Windows.Forms.FormClosingEventArgs]
	#TODO: Place custom script here
	Write-Log -Message "Hello form is closing."
	$formSTD1_Hello.Visible = $false
	$FRBOpenProcessesToCheck = ConvertStringTo-FRBProcess -strOpenProcess $appStopRequiredProcesses
	$OpenProcessesPrompt = $FRBOpenProcessesToCheck | Get-FRBOpenProcess -DoPrompt
	
	If (($script:continueNowHello -eq $true) -and ($OpenProcessesPrompt))
	{
		Write-Log -Message "Hello dialog is closing since Continue Now button was clicked."
		Write-Log -Message "Will launch the OpenProcessPrompt dialog."
		Show-CloseOpenApps_psf -appName $appName -appVersion $appVersion -appStopRequiredProcesses $appStopRequiredProcesses
		
	}
	Elseif ($OpenProcessesPrompt)
	{
		Write-Log -Message "Hello dialog is closing because the timer on the form ran out."
		Write-Log -Message "Will launch the Reminder dialog."
		
		Show-InstallReminder_psf -appName $appName -appVersion $appVersion -processlist $processlist -appStopRequiredProcesses $appStopRequiredProcesses		
	}
	Else
	{
		Write-Log -Message "Proceeding without launching OpenProcessPrompt or Reminder dialogs."
	}
	#Start-Process -FilePath "C:\Windows\notepad.exe"
}

$labelCloseAppMsg_Click={
	#TODO: Place custom script here
	
}




<#$linklabelMoreDetail_LinkClicked=[System.Windows.Forms.LinkLabelLinkClickedEventHandler]{
#Event Argument: $_ = [System.Windows.Forms.LinkLabelLinkClickedEventArgs]
	#TODO: Place custom script here
	If ($linklabelMoreDetail.Text -eq "More Detail")
	{
		$linklabelMoreDetail.Text = "Less Detail"
		$formHello.Height = $listbox1.Location.Y + $listbox1.Height + 2
		Load-ListBox -ListBox $listbox1 -DisplayMember "FriendlyDescription" -Items $processlist
	}
	ElseIf ($linklabelMoreDetail.Text -eq "Less Detail")
	{
		$linklabelMoreDetail.Text = "More Detail"
		$formHello.Height = $goalHeight
	}
}

$labelPKGR_MSI_ARPVERSION_Click={
	#TODO: Place custom script here
	
}#>

$labelAppInfo_Click={
	#TODO: Place custom script here
	
}
]]></Code>
