  <Code><![CDATA[param (
	[Parameter(Mandatory = $true)]
	$appName,
	$appVersion,
	$processlist,
	$appStopRequiredProcesses,
	[switch]$forceReboot = $false
)

$formReminder_Load={
	#Initialize Form Controls
	$formReminder.AutoScaleMode = 'DPI'
	$formReminder.AutoSize = $false
	$labelAppInfo.Text = "$appName $appVersion"
	if ($appName.Contains($appVersion)){$labelAppInfo.Text = $appName}
	$labelCloseList.Text = Format-FRBProcesses -appStopRequiredProcesses $appStopRequiredProcesses
	$buttonMinimize.Visible = $true
	If ($forceReboot)
	{
		$labelUpdateAvailable.Text = "Update and Restart Reminder"
		$labelCloseAppMsg.Text = "We are back and would really like to update your device. We will need to restart IMMEDIATELY AFTER."
		$labelWillAskYouToClose.Visible = $false
		$labelprocesslist.Visible = $false
	}
	#--Set form location
	$Size = [System.Windows.Forms.SystemInformation]::PrimaryMonitorSize
	$xResolution = $Size.Width
	$yResolution = $Size.Height	
	$xLocation = $xResolution - 20 - ($formReminder.Width) #20 pixels from right end of screen	
	$yLocation = 55
	$Script:parentFormLocX = $xLocation					# Define script variables so that 
	$Script:parentFormLocY = $yLocation					# child form (minutes selection)
	$Script:parentFormWidth = $formReminder.Width		# is aware of the parent form's location
	$Script:parentFormHeight = $formReminder.Height     #
	#--Play Sound
	$sound = new-Object System.Media.SoundPlayer;
	$sound.SoundLocation = "c:\WINDOWS\Media\notify.wav";
	$sound.Play();
	#--Render Reminder form
	$formReminder.StartPosition = 'Manual'
	$formReminder.Location = New-Object System.Drawing.Point($xLocation, $yLocation)
	$Script:formReminderVertical = $formReminder.Size.Height
	$formReminder.Height = $formReminderVertical
	$script:goalHeightReminder = $buttonDelay.Location.Y + $buttonDelay.Height + 2
	Write-Log "Initial Goal Height Reminder = $goalHeightReminder"
	$Script:parentFormHeightCollapse = $buttonDelay.Location.Y + $buttonDelay.Height
	#--Initiate and start timer
	$script:DialogTimingConfig = Get-DialogTimingConfig
	$script:EndTime = (Get-Date).AddMinutes($script:DialogTimingConfig.InstallReminderTimeoutMinutes) # this 'Minutes' is the number of minutes the dialog will stay up.
	$timerReminder.Enabled = $true
	$timerReminder.Interval = 1000 # internval is in milliseconds, so 1000 means a second. 
	$timerReminder.Start()
	$timerReminder.add_Tick($timerReminder_Tick)
}

$timerReminder_Tick = {
	$span = $script:EndTime - (Get-Date)
	If ($buttonDelay.Enabled -eq $false)
	{
		$formReminder.Height = $formReminderVertical
		$labelTimer.Text = $span.Tostring().Substring(0, 8)
	}
	If ($span.totalseconds -le 60)
	{
		$buttonMinimize.Enabled = $false
		$buttonMinimize.Visible = $false
		$labelCloseList.Text = Format-FRBProcesses -appStopRequiredProcesses $appStopRequiredProcesses
		$formReminder.WindowState = 'Normal'
		$countdown = $span.totalseconds		
	}
	if ($span.totalseconds -le 0)
	{
		Write-Log "Reminder timer is now 0 seconds."
		$timerReminder.Stop()
		$formReminder.Close()
	}
}



$buttonContinueNow_Click={
	Write-Log "USER ACTION [Reminder]: Continue Now button was clicked"
	$formReminder.Close()
}


$buttonDelay_Click={	
	Write-Log "USER ACTION [Reminder]: Delay Button clicked"
	$buttonContinueNow.BackColor = $ButtonDisableColor
	$buttonDelay.BackColor = $ButtonDisableColor
	$formReminder.Height = $goalHeightReminder
	Write-Log "Form Height = $goalHeightReminder"
	if ((Show-TimeDelayLastCall_psf) -eq 'OK'){}
	$buttonContinueNow.BackColor = $ButtonEnableColor
	$buttonDelay.BackColor = $ButtonEnableColor
	If (!$FinalMinsCancelSelected)
	{
		$timeSelected = (Get-DialogTimingConfig).LastCallMinutes
		$script:EndTime = (Get-Date).AddMinutes($timeSelected) # this 'Minutes' is the number of minutes the dialog will stay up.
		$script:span = $script:span + ($script:EndTime - (Get-Date))
		$buttonDelay.Enabled = $false
		$buttonDelay.BackColor = $ButtonDisableColor		
		$formReminder.TopMost = $false
		$formReminder.WindowState = 'Minimized'
		$buttonMinimize.Visible = $true
		$formReminder.Height = $formReminderVertical
	}
	Else
	{
		$formReminder.Height = $formReminderVertical
		$script:FinalMinsCancelSelected = $false
	}
	
}


$buttonMinimize_Click = {
	$formReminder.WindowState = 'Minimized'
}

$formReminder_FormClosing=[System.Windows.Forms.FormClosingEventHandler]{
	$formReminder.Visible = $false
	Write-Log "Closing Reminder form"
	$FRBOpenProcessesToCheck = ConvertStringTo-FRBProcess -strOpenProcess $appStopRequiredProcesses
	$OpenProcessesPrompt = $FRBOpenProcessesToCheck | Get-FRBOpenProcess -DoPrompt
	if ($OpenProcessesPrompt)
	{
		Write-Log "Launching OpenProcessPrompt dialog."
		Show-CloseOpenApps_psf -appName $appName -appVersion $appVersion -appStopRequiredProcesses $appStopRequiredProcesses
	}
	Else
	{
		Write-Log "Proceeding without launching OpenProcessPrompt."
	}
}
$labelCloseAppMsg_Click={
	
}

$labelUpdateStillAvailable_Click={

}

$labelInstalling_Click={
	#TODO: Place custom script here
	
}
]]></Code>
