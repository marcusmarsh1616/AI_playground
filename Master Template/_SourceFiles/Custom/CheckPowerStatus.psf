	#TODO: Place custom script here
	
}

$labelHelloWeAreUpdatingTh_Click={
	#TODO: Place custom script here
	
}

$buttonMinimize_Click={
	#TODO: Place custom script here
	$FormPromptOpenProcess.WindowState = 'Minimized'
}

