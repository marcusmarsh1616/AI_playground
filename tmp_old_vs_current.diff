+function Test-PackageDeploymentReadiness {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$PackagePath,
+
+        [Parameter(Mandatory = $true)]
+        [string]$AppName
+    )
+
+    $readiness = @{
+        Ready = $true
+        MissingItems = @()
+    }
+
+    $docsFolder = Join-Path $PackagePath "Docs"
+    if (-not (Test-Path $docsFolder)) {
+        $readiness.Ready = $false
+        $readiness.MissingItems += "Docs folder"
+    }
+    else {
+        $installValidation = Get-ChildItem -Path $docsFolder -File -Filter "* Validation report.html" -ErrorAction SilentlyContinue
+        if (-not $installValidation -or $installValidation.Count -eq 0) {
+            $readiness.Ready = $false
+            $readiness.MissingItems += "Installation validation report (*. Validation report.html in Docs)"
+        }
+
+        $uninstallValidation = Get-ChildItem -Path $docsFolder -File -Filter "Uninstall_Report_*.html" -ErrorAction SilentlyContinue
+        if (-not $uninstallValidation -or $uninstallValidation.Count -eq 0) {
+            $readiness.Ready = $false
+            $readiness.MissingItems += "Uninstallation validation report (Uninstall_Report_*.html in Docs)"
+        }
+    }
+
+    $detectCandidates = @(
+        "{0}_Detect_R1.ps1" -f $AppName,
+        "{0}_Detect_R1.ps1" -f (($AppName -replace '\\s+', '_'))
+    ) | Select-Object -Unique
+
+    $detectFound = $false
+    foreach ($candidate in @($detectCandidates)) {
+        if (Test-Path (Join-Path $PackagePath $candidate)) {
+            $detectFound = $true
+            break
+        }
+    }
+
+    if (-not $detectFound) {
+        $readiness.Ready = $false
+        $readiness.MissingItems += ("Detection script ({0})" -f ($detectCandidates -join " or "))
+    }
+
+    return $readiness
+}
